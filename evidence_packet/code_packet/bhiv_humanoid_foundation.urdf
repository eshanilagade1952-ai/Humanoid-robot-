  </joint>
  <joint name="r_ankle_roll_joint" type="revolute">
    <parent link="r_ankle_link"/><child link="r_foot_link"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.5" upper="0.5" effort="3.0" velocity="5.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
</robot>
